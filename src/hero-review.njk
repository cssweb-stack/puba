---
layout: false
title: Hero Review
permalink: /hero-review.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>PUBA Hero Review</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="{{ site.stylesheet | url }}" rel="stylesheet">
</head>
<body>
<main class="site-main">
<div class="page-section">
<div class="container content-section">
<h1>PUBA Hero Review</h1>
<p>Every page’s current hero, using the site’s actual image crop, height, and overlay settings. Resize the window to compare desktop, tablet, and mobile.</p>
</div>
</div>
{% for entry in collections.all | sort(false, false, 'url') %}
{% if entry.url %}
<div class="page-section">
<div class="container content-section">
<h2><a href="{{ entry.url | url }}">{{ entry.inputPath | replace('./src/', '') | escape }}</a></h2>
{% set assigned = heroes.pages[entry.url] or faculty_heroes.pages[entry.url] %}
<p>Image: {{ assigned.image | default(entry.data.hero) | default(site.defaultHero) | escape }}</p>
</div>
{% set page = entry.data.page %}
{% set hero = entry.data.hero %}
{% set heroAlt = entry.data.heroAlt %}
{% include "layouts/hero/hero.njk" %}
</div>
{% endif %}
{% endfor %}
</main>
</body>
</html>
